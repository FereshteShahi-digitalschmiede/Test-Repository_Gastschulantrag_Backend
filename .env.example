# API
PORT=3100
# Erlaubte Frontend-Origins (kommagetrennt), z. B. GitHub Pages und lokale Entwicklung
CORS_ORIGINS=http://localhost:5173,https://fereshteshahi-digitalschmiede.github.io

# PostgreSQL (siehe docker-compose.yml)
DATABASE_URL=postgresql://gastschule:gastschule@localhost:54320/gastschule

# S3-kompatibler Dateispeicher (lokal: SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=nachweise

# Login Bearbeitungsseite (lokal: Keycloak, Realm gastschule aus keycloak/realm-gastschule.json)
OIDC_ISSUER=http://localhost:8080/realms/gastschule
OIDC_CLIENTS=bearbeitung

# E-Mail (lokal: Mailpit, Weboberfläche unter http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
S3_REGION=eu-central-1
S3_ACCESS_KEY=lokal
S3_SECRET_KEY=lokal
