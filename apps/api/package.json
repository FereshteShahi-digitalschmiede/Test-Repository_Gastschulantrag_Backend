{
  "name": "@gastschulantrag/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json -w --preserveWatchOutput & sleep 4 && node --env-file-if-exists=../../.env --enable-source-maps --watch dist/main.js",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@gastschulantrag/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  }
}
