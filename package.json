{
  "name": "gastschulantrag-backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @gastschulantrag/shared build && pnpm --filter @gastschulantrag/api dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
